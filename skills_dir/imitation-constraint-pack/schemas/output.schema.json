    "soft_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "forbidden_transformations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "continuity_memory": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
